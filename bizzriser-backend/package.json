{
  "name": "bizzriser-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "build": "npx prisma generate && npx prisma migrate deploy && nest build",
    "build:prod": "node prisma/fix-provider.js && node node_modules/prisma/build/index.js generate && node node_modules/@nestjs/cli/bin/nest.js build",
    "prisma:deploy": "node prisma/fix-provider.js && node node_modules/prisma/build/index.js generate && node node_modules/prisma/build/index.js db push",
    "fix-permissions": "chmod +x node_modules/.bin/prisma node_modules/.bin/nest || true",
    "postinstall": "node prisma/fix-provider.js && (node node_modules/prisma/build/index.js generate || echo 'Prisma generate failed, will try at runtime')",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "node node_modules/eslint/bin/eslint.js \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "6.2.1",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "uuid": "^13.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "prisma": "6.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.13",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.2.3",
    "@swc/core": "^1.11.5",
    "@swc/helpers": "^0.5.15",
    "@swc/cli": "^0.5.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/testing": "^11.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "node node_modules/ts-node/dist/bin.js prisma/seed.ts"
  }
}