# BizzRiser Backend - Environment Variables Template

# App Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL="https://your-frontend-domain.com"
HOSTINGER=true

# Database Configuration (MySQL on Hostinger)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://u123456789_user:your-password@127.0.0.1:3306/u123456789_db"

# JWT Configuration
JWT_SECRET="your-super-secret-key"

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Admin Notifications
ADMIN_NOTIFY_EMAIL="hello@bizzriser.com"

# AWS S3 (If used for file uploads)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""
